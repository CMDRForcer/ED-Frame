CATALOG_HOST=catalog.example.invalid
POSTGRES_DB=edframe_catalog
POSTGRES_USER=edframe_catalog
POSTGRES_PASSWORD=replace-with-a-long-random-value
EDFRAME_MINING_SNAPSHOT_PROTOCOL=0
