{$CATALOG_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    # Public, read-only statistics for the ED-Frame project website.
    # No credentials, upload endpoints or other API paths are exposed by CORS.
    @website_statistics {
        method GET
        path /v1/status
    }
    header @website_statistics Access-Control-Allow-Origin "https://cmdrforcer.github.io"

    reverse_proxy api:8000
}

